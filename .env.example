# Lokale Entwicklungsdatenbank (PostgreSQL 16)
DATABASE_URL="postgresql://kurswerk:kurswerk@localhost:5432/kurswerk?schema=public"

# Anmeldung (Demo)
SESSION_SECRET="entwicklung-nur-lokal-bitte-ersetzen"
DEMO_LOGIN=1
DEMO_ORG_SLUG="beispielschule"

# E-Mail-Versand. Ohne diese Werte schreibt die App Mails als Textdatei nach .mail-outbox/ (nur Entwicklung).
