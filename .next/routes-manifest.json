    },
    {
      "page": "/datenschutz",
      "regex": "^/datenschutz(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/datenschutz(?:/)?$"
    },
    {
      "page": "/impressum",
      "regex": "^/impressum(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/impressum(?:/)?$"
    },
    {
      "page": "/lehrkraft",
      "regex": "^/lehrkraft(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/lehrkraft(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/nutzungsbedingungen",
      "regex": "^/nutzungsbedingungen(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/nutzungsbedingungen(?:/)?$"
    },
    {
      "page": "/passwort-vergessen",
      "regex": "^/passwort\\-vergessen(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/passwort\\-vergessen(?:/)?$"
    },
    {
      "page": "/registrieren",
      "regex": "^/registrieren(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/registrieren(?:/)?$"
    },
    {
      "page": "/unterricht",
      "regex": "^/unterricht(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/unterricht(?:/)?$"
    },
    {
      "page": "/verwaltung",
      "regex": "^/verwaltung(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/verwaltung(?:/)?$"
    },
    {
      "page": "/verwaltung/einstellungen",
      "regex": "^/verwaltung/einstellungen(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/verwaltung/einstellungen(?:/)?$"
    },
    {
      "page": "/verwaltung/heute",
      "regex": "^/verwaltung/heute(?:/)?$",
      "routeKeys": {},
